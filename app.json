{
  "expo": {
    "name": "mobile-historytalk",
    "slug": "mobile-historytalk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "mobilehistorytalk",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.mobilehistorytalk"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2E8D5",
          "android": {
            "image": "./assets/logo.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      "expo-video",
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Cho phep HistoryTalk su dung micro de nhap noi dung bang giong noi",
          "speechRecognitionPermission": "Cho phep HistoryTalk nhan dang giong noi thanh van ban"
        }
      ],
      "expo-audio",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Streak",
              "label": "HistoryTalk - Chuỗi ngày học",
              "description": "Xem chuỗi ngày học và một nhân vật lịch sử ngẫu nhiên",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 3,
              "targetCellHeight": 3,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
