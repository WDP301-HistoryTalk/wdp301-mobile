# ============================
# API Configuration
# ============================
# Android Emulator: http://10.0.2.2:5000/api/v1
# iOS Simulator:    http://localhost:5000/api/v1
# Physical device:  http://<your-local-ip>:5000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# ============================
# Google OAuth
# Tạo OAuth credentials tại: https://console.cloud.google.com
# Application type: Web application
# Authorized redirect URIs:
#   - https://auth.expo.io/@<your-expo-username>/mobile-historytalk  (Expo Go dev)
#   - mobilehistorytalk://oauth2redirect/google  (production build)
# ============================
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
# (Tùy chọn) Native client ID cho Android build
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com
# (Tùy chọn) Native client ID cho iOS build
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com


